{{#get
  'tags' filter='visibility:public' include='count.posts' order='count.posts desc' limit='100'
}}{{#if tags}}
<nav class="bp-topic-ribbon" id="topics" aria-label="Explore article topics">
  <span>PICK YOUR RABBIT HOLE →</span><a href="{{@site.url}}">All bytes</a>{{#foreach tags}}<a
    href="{{url}}"
    >{{name}} <small>{{count.posts}}</small></a
  >{{/foreach}}
</nav>
{{/if}}{{/get}}
