{{#get "tags" include="count.posts" filter="visibility:public+count.posts:>0" order="count.posts desc" limit="6"}}{{#if tags}}
<section class="bp-trail bp-topic-discovery" id="topics" aria-labelledby="topics-title">
  <div><span class="bp-kicker">A DIFFERENT WAY IN</span><h2 id="topics-title">{{@custom.topics_title}}</h2>{{#if @custom.topics_description}}<p>{{@custom.topics_description}}</p>{{/if}}</div>
  <div class="bp-topic-grid">{{#foreach tags}}<a href="{{url}}"><span class="bp-topic-heading"><b>{{name}}</b><span aria-hidden="true">↗</span></span>{{#if description}}<p>{{description}}</p>{{/if}}<small>{{plural count.posts empty="No bytes yet" singular="1 byte" plural="% bytes"}}</small></a>{{/foreach}}</div>
</section>
{{/if}}{{/get}}
