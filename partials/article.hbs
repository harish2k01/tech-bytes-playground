<div class="bp-reading-progress" data-reading-progress aria-hidden="true"></div>
<article
  class="single {{post_class}} {{#if no_image}}no-feature-image{{/if}} {{#if image_width}}image-{{image_width}}{{/if}}"
>
  <header class="bp-article-intro">
    <a class="bp-back" href="{{@site.url}}">← Back to exploring</a>
    {{#is "post"}}<div class="bp-article-category">{{#primary_tag}}<a class="bp-chip" href="{{url}}">{{name}}</a>{{/primary_tag}}<span class="bp-article-spark" aria-hidden="true">✳</span></div>{{/is}} {{#match @page.show_title_and_feature_image}}
    <h1>{{title}}</h1>
    {{#if custom_excerpt}}
    <p>{{custom_excerpt}}</p>
    {{/if}}{{/match}} {{#is "post"}}
    <div class="bp-article-details"><div class="bp-meta">
      {{#foreach authors}}<a href="{{url}}">{{name}}</a>{{/foreach}}<span>·</span
      ><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time><span>·</span
      ><span>{{reading_time}}</span
      >
    </div><div class="bp-article-actions"><button data-share hidden>Share this byte ↗</button><button data-focus aria-pressed="false" hidden>Focus mode</button></div></div>
    {{/is}}
  </header>
  {{#match @page.show_title_and_feature_image}}{{#if feature_image}}{{#unless no_image}}
  <figure class="article-feature">
    <img
      src="{{img_url feature_image size="l"}}"
      srcset="
        {{img_url feature_image size="m"}}  750w,
        {{img_url feature_image size="l"}} 1200w,
        {{img_url feature_image size="xl"}} 1800w,
        {{img_url feature_image size="xxl"}} 2400w
      "
      sizes="(max-width: 900px) 95vw, 1200px"
      alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
      fetchpriority="high"
    />{{#if feature_image_caption}}
    <figcaption>{{{feature_image_caption}}}</figcaption>
    {{/if}}
  </figure>
  {{/unless}}{{/if}}{{/match}}
  <div class="bp-reading">
    <aside data-toc-container hidden>
      <nav aria-label="In this article">
        <span class="bp-kicker">IN THIS BYTE</span>
        <ol data-toc></ol>
      </nav>
    </aside>
    <div class="article-body gh-content">{{content}}</div>
  </div>
  {{#is "post"}}
  <footer class="article-footer content-width">
    <div class="post-navigation">
      {{#prev_post}}<a href="{{url}}"><small>PREVIOUS BYTE</small>{{title}} ←</a
      >{{/prev_post}}{{#next_post}}<a href="{{url}}"
        ><small>NEXT BYTE</small>{{title}} →</a
      >{{/next_post}}
    </div>
  </footer>
  {{/is}}
</article>
